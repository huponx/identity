ENV=local
IDENTITY_ISSUER=http://localhost:8080
IDENTITY_SIGNING_KEY_FILE=./dev-keys/k1.pem   # openssl ecparam -name prime256v1 -genkey -noout -out dev-keys/k1.pem
IDENTITY_SIGNING_KEY_ID=k1
IDENTITY_MFA_MODE=optional                    # off | optional | required
# IDENTITY_REGISTRATION_ENABLED=true          # self-registration (POST /auth-api/register), default role member
IDENTITY_MFA_KEY=k1:CHANGE_ME_BASE64_32_BYTES # openssl rand -base64 32
SETUP_ADMIN_PASSWORD=                         # identity-setup only (first admin), with SETUP_CONFIG
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
REDIS_HOST=localhost
# COURIER_TARGET=localhost:9091               # empty: reset/MFA links are logged (ENV=local)
